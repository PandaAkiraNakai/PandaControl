[Unit]
Description=apppanda backend — HTTP/SSE bridge para la app Android AppPanda
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/apppanda-backend
# INSTALL.sh reemplaza __TARGET_USER__ y __TARGET_GROUP__ con el usuario actual.
User=__TARGET_USER__
Group=__TARGET_GROUP__
Restart=on-failure
RestartSec=5

# Estado: SQLite WAL + audit log. systemd crea los dirs.
StateDirectory=apppanda-backend
LogsDirectory=apppanda-backend
StateDirectoryMode=0700
LogsDirectoryMode=0750

# Hardening
# ProtectHome=no porque el módulo Files sirve/escribe [files].shared_dirs
# (típicamente bajo ~), el módulo Temas lee [themes].dir (por default
# ~/.config/apppanda-backend/temas) y el visor de memorias/pedidos abre
# la SQLite de `mem` en ~/.local/share/mem/memory.db — todas rutas bajo el
# home del usuario, configurables, que un ProtectHome=read-only bloquearía
# para escritura (uploads, mkdir, rename, delete). No hay forma de acotar
# esto a subrutas fijas en ReadWritePaths porque shared_dirs lo define el
# usuario en config.toml, no este unit.
# El resto SÍ queda estricto: el daemon no toca /tmp en ningún lado del
# código (sin tempfile, sin rutas /tmp/ hardcodeadas) ni crea namespaces
# propios, así que PrivateTmp/RestrictNamespaces se dejan en su default
# seguro en vez de aflojados.
ProtectSystem=strict
ProtectHome=no
ReadOnlyPaths=/etc/apppanda-backend
ReadWritePaths=/var/lib/apppanda-backend /var/log/apppanda-backend
PrivateTmp=yes
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
